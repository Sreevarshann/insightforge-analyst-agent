# Copy to backend/.env and adjust. Never commit real values.
INSIGHTFORGE_ENVIRONMENT=development
INSIGHTFORGE_API_PORT=8111
INSIGHTFORGE_CORS_ORIGINS=["http://localhost:3101"]
INSIGHTFORGE_DATA_DIR=./var

# LLM: ollama | openai_compatible | fixture
INSIGHTFORGE_LLM_PROVIDER=ollama
INSIGHTFORGE_LLM_BASE_URL=http://127.0.0.1:11434
INSIGHTFORGE_LLM_MODEL=qwen3:4b-instruct
# INSIGHTFORGE_LLM_API_KEY=   # only for openai_compatible providers

INSIGHTFORGE_QUERY_TIMEOUT_SECONDS=10
INSIGHTFORGE_QUERY_MAX_ROWS=10000
INSIGHTFORGE_SANDBOX_MEMORY_MB=1024
